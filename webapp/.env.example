# ──────────────────────────────────────────────────────────────────────────────
# RepRoom · Environment Variables
# Copy to .env.local and fill in. All secrets are server-side only.
# The browser only ever receives the two NEXT_PUBLIC_ Supabase values below.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL + anon key are safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key: SERVER ONLY. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Database (Drizzle / postgres.js) ─────────────────────────────────────────
# Pooled connection (PgBouncer, port 6543) for the app runtime.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) for running migrations with drizzle-kit.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────────
# Canonical site URL, used for auth redirect callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI models — NVIDIA NIM (default, free/open-source, OpenAI-compatible) ─────
# Server-only. Add the real value in the Cursor Secrets panel / Vercel env, not here.
NVIDIA_NIM_API_KEY=nvapi-...
NIM_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Any chat model the key can reach (see `node --env-file=.env.local scripts/nim-check.mjs`).
NIM_LLM_MODEL=meta/llama-3.3-70b-instruct

# ── Optional alternative providers (adapters added behind the same interfaces) ─
# STT default is NVIDIA NIM/Riva (mirrors the VeilAssist desktop app). Deepgram optional.
# DEEPGRAM_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
