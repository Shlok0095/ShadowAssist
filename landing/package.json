{
  "name": "veilassist-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/postbuild.cjs",
    "build:mobile": "vite build --config vite.mobile.config.ts && node scripts/prepare-mobile-dist.cjs",
    "cap:sync": "cap sync android",
    "build:android-apk": "npm run build:mobile && cap sync android && cd android && node -e \"require('child_process').execSync(process.platform==='win32'?'gradlew.bat assembleDebug':'./gradlew assembleDebug',{stdio:'inherit'})\" && node scripts/copy-android-apk.cjs",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "framer-motion": "^11.15.0",
    "lenis": "^1.3.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "pdfjs-dist": "^4.10.38",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.3.3",
    "vite": "^5.4.11"
  }
}
