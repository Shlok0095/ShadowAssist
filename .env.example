# ──────────────────────────────────────────────────────────────────────────────
# VeilAssist · Environment Variables
# Aligned with Natively AI provider architecture
#
# Copy this file to .env and fill in your keys.
# Keys marked "stored in app" are saved encrypted via electron-store / safeStorage
# and do NOT need to be in .env — they are set through the Settings UI at runtime.
# ──────────────────────────────────────────────────────────────────────────────

# ── AI / LLM Providers ────────────────────────────────────────────────────────

# OpenAI (GPT-4o, GPT-4 Turbo, Whisper STT)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (Gemini 1.5 Flash, Gemini 1.5 Pro, Gemini 2.0)
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Groq (Llama 3.1/3.3 70B, Llama 4 Scout — also used for Whisper STT)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# xAI Grok (Grok-2, Grok-3)
# https://console.x.ai/
XAI_API_KEY=xai-...

# Mistral AI (Mistral Large, Codestral)
# https://console.mistral.ai/
MISTRAL_API_KEY=...

# Perplexity (Sonar, Sonar Pro)
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# OpenRouter (routes to 200+ models via a single key)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Together AI (Llama, DBRX, Mixtral)
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=...

# NVIDIA NIM (Llama 3.1 Nemotron, Mistral NeMo — also Whisper STT via Riva)
# https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...

# Fireworks AI (Llama 3.1, FireLLaVA)
# https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=fw_...

# Cerebras (fast Llama inference)
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-...

# DeepSeek
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Moonshot / Kimi
# https://platform.moonshot.cn/
MOONSHOT_API_KEY=sk-...

# Custom OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, etc.)
CUSTOM_OPENAI_BASE_URL=http://localhost:11434/v1
CUSTOM_OPENAI_API_KEY=ollama

# ── Google Calendar (optional — meeting reminders) ───────────────────────────
# Desktop OAuth app from Google Cloud Console (Calendar API enabled).
# For packaged builds: set as GitHub Secrets and run scripts/inject-oauth.cjs before build.
# Or paste credentials in Settings → Meetings → Developer setup for local dev.
VEILASSIST_GOOGLE_CAL_CLIENT_ID=
VEILASSIST_GOOGLE_CAL_CLIENT_SECRET=

# ── Speech-to-Text (STT) Providers ───────────────────────────────────────────
# These are DEDICATED STT keys, separate from the LLM keys above.
# Natively AI supports streaming STT from these providers.

# Deepgram (Nova-2, Nova-3 — streaming + batch; recommended for low-latency)
# https://console.deepgram.com/
DEEPGRAM_API_KEY=...
# Model to use (nova-2 | nova-3 | enhanced | base)
DEEPGRAM_MODEL=nova-2

# ElevenLabs (Scribe v1 — high-accuracy English STT)
# https://elevenlabs.io/app/speech-to-text
ELEVENLABS_API_KEY=sk_...

# Microsoft Azure Cognitive Services (Speech SDK — streaming)
# https://portal.azure.com/ → Cognitive Services → Speech
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus

# Google Cloud Speech-to-Text (v2 — streaming)
# https://console.cloud.google.com/apis/credentials
GOOGLE_STT_KEY=AIza...
# For service account auth (alternative to API key):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Audio Fallback (secondary STT for silence / fallback) ────────────────────
# If primary STT fails, VeilAssist can fall back to a different provider.
# Set AUDIO_FALLBACK_PROVIDER to one of: openai | groq | deepgram | elevenlabs
AUDIO_FALLBACK_PROVIDER=groq
# Key for the fallback provider (leave blank to reuse the provider key above)
AUDIO_FALLBACK_KEY=

# ── Screen Capture / Vision ───────────────────────────────────────────────────
# Natively-style on-demand screen capture via Ctrl+H hotkey.
# No additional keys needed — uses the LLM vision API keys above.
# Vision providers tried in order: OpenAI → Gemini Flash → Claude → Groq Scout

# ── Build / Release (CI only) ────────────────────────────────────────────────
# These are NOT used at runtime — only by the GitHub Actions release workflow.

# GitHub personal access token (for release uploads)
# GITHUB_TOKEN=ghp_...

# Code signing certificate (Windows — base64-encoded PFX)
# CSC_LINK=...
# CSC_KEY_PASSWORD=...

# Apple notarization (macOS)
# APPLE_ID=...
# APPLE_APP_SPECIFIC_PASSWORD=...
# APPLE_TEAM_ID=...
